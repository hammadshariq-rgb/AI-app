{
  "name": "callisto",
  "version": "1.7.3",
  "description": "Callisto — your own personal AI assistant",
  "keywords": [
    "AI",
    "assistant",
    "personal AI",
    "voice assistant",
    "jarvis"
  ],
  "author": {
    "name": "Hammad Shariq",
    "email": "hammad.shariq@hotmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hammadshariq-rgb/AI-app.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.hammadshariq.yourpersonalai",
    "productName": "Callisto AI",
    "copyright": "Copyright © 2025 Hammad Shariq",
    "publish": [
      {
        "provider": "github",
        "owner": "hammadshariq-rgb",
        "repo": "AI-app",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "artifactName": "Callisto-AI-Setup-${version}.${ext}",
      "executableName": "Callisto",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Hammad Shariq"
    },
    "mac": {
      "artifactName": "Callisto-AI-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Callisto needs microphone access to hear your voice commands.",
        "NSCameraUsageDescription": "Callisto needs camera access for hand gesture control.",
        "NSAppleEventsUsageDescription": "Callisto needs permission to control other apps so it can open apps, play music in Spotify and switch windows when you ask.",
        "NSScreenCaptureUsageDescription": "Callisto needs to see your screen so screen assist can answer questions about what you are looking at, and so the Magic Cursor can identify whatever you circle.",
        "NSSpeechRecognitionUsageDescription": "Callisto turns what you say into text so it can act on your spoken requests.",
        "NSDownloadsFolderUsageDescription": "Callisto saves the documents, spreadsheets and pictures it makes for you.",
        "NSDocumentsFolderUsageDescription": "Callisto opens and saves the documents you ask it to work on."
      },
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Callisto AI",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "castv2-client": "^1.2.0",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "multicast-dns": "^7.2.5",
    "node-fetch": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "protobufjs@6.11.6": true
  }
}
