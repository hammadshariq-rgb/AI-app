OPENAI_API_KEY=sk-proj-...
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/...
STRIPE_SECRET_KEY=sk_live_... (or sk_test_... for testing)
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_ANNUAL=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
JWT_SECRET=<random 64-char hex string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
PUBLIC_URL=https://your-server-domain.com
PORT=4000
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...
OUTLOOK_CLIENT_ID=...
OUTLOOK_CLIENT_SECRET=...
INSTAGRAM_CLIENT_ID=...
INSTAGRAM_CLIENT_SECRET=...
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...

# ── AI phone calling (Vapi) ──────────────────────────────────────────────────
# Create an account at vapi.ai, then:
#   1. Dashboard → API Keys → copy the PRIVATE key (not the public one)
#   2. Dashboard → Phone Numbers → buy a number (or import an existing Twilio one)
#      and copy its ID (a UUID, not the phone number itself)
#   3. Generate a webhook secret: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave these unset to keep calling disabled — the app greys the feature out.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
CALL_WEBHOOK_SECRET=

# ── Shopping search ──────────────────────────────────────────────────────────
# eBay is the only one of these four with a product API open to third parties.
# Create an app at developer.ebay.com → keys → use the PRODUCTION App ID / Cert ID.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Optional affiliate tags — these earn commission on what users buy.
# eBay Partner Network campaign ID (partnernetwork.ebay.com)
EBAY_CAMPAIGN_ID=
# Amazon Associates tracking ID (affiliate-program.amazon.com)
AMAZON_ASSOCIATE_TAG=
# Raw query-string suffixes, e.g. "aff_trace_key=..." — appended to search links
ALIEXPRESS_AFFILIATE_SUFFIX=
TEMU_AFFILIATE_SUFFIX=

# ── Text-to-3D (Meshy) ───────────────────────────────────────────────────────
# OpenAI has no 3D model API. Meshy takes a text prompt and returns a GLB.
# Sign up at meshy.ai → Settings → API Keys. Generation costs credits per model
# and takes roughly 40-90 seconds. Leave unset to keep 3D generation disabled.
MESHY_API_KEY=
